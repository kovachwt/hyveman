<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Hyveman.Server</RootNamespace>
    <AssemblyName>hyveman-server</AssemblyName>
    <Version>0.1.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- ACL helpers are deliberately guarded by OperatingSystem.IsWindows() at runtime. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <DebugType>embedded</DebugType>
    <!-- Windows publishes a self-contained single-file exe by default (Windows is the
         agent/server production form). On Linux the same flags are passed explicitly at
         publish time (linux-x64, self-contained, single-file), so the build stays
         portable here. -->
    <RuntimeIdentifier Condition="'$(OS)' == 'Windows_NT'">win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(OS)' == 'Windows_NT'">true</SelfContained>
    <PublishSingleFile Condition="'$(OS)' == 'Windows_NT'">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(OS)' == 'Windows_NT'">true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Certes" Version="3.0.4" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Fido2" Version="4.0.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.29" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="2.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test project lives under tests/; keep it out of the server build's default globbing. -->
    <Compile Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <None Remove="tests\**" />
    <Content Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Storage\Migrations\*.sql" />
  </ItemGroup>

</Project>
