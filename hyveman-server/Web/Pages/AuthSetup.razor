@page "/auth/setup"
@namespace Hyveman.Server.Web.Pages
@using System.Text.Json
@using Hyveman.Server.Auth

<div class="auth-card">
    <h1>🔐 First-run setup</h1>
    <p class="muted">No passkeys registered yet. Register the first passkey to secure this
        Hyveman installation. Use a platform authenticator (Windows Hello) or a security key.
        It is strongly recommended to register a second passkey afterwards.</p>

    @if (!string.IsNullOrEmpty(Error)) { <div class="err">@Error</div> }
    @if (!string.IsNullOrEmpty(Ok)) { <div class="okmsg">@Ok</div> }

    <label for="name">Passkey name</label>
    <input id="name" @bind="PasskeyName" placeholder="e.g. admin-phone" />

    <button @onclick="RegisterAsync" disabled="@Busy">@(Busy ? "Contacting authenticator…" : "Register passkey")</button>
    <p class="muted" style="margin-top:14px">After registration you will be signed in automatically.</p>
</div>

@code {
    [Inject] private IJSRuntime Js { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private PasskeyService Passkeys { get; set; } = default!;

    private string PasskeyName { get; set; } = "admin-" + Environment.MachineName.ToLowerInvariant();
    private string? Error { get; set; }
    private string? Ok { get; set; }
    private bool Busy { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (await Passkeys.HasPasskeysAsync())
            Nav.NavigateTo("/dashboard", forceLoad: true);
    }

    private async Task RegisterAsync()
    {
        Busy = true; Error = null; Ok = null;
        try
        {
            var client = new HttpClient();
            var optionsResp = await client.PostAsJsonAsync(Nav.BaseUri + "api/auth/register-options", new { name = PasskeyName });
            if (!optionsResp.IsSuccessStatusCode) { Error = "Server refused registration options."; return; }
            var optionsJson = await optionsResp.Content.ReadAsStringAsync();

            var attestation = await Js.InvokeAsync<JsonElement>("hyveman.createCredential", optionsJson);
            var verifyResp = await client.PostAsJsonAsync(Nav.BaseUri + "api/auth/register-verify", new
            {
                name = PasskeyName,
                response = new
                {
                    id = attestation.GetProperty("id").GetString(),
                    clientDataJson = attestation.GetProperty("response").GetProperty("clientDataJSON").GetString(),
                    attestationObject = attestation.GetProperty("response").GetProperty("attestationObject").GetString(),
                    transports = attestation.GetProperty("response").TryGetProperty("transports", out var t)
                        ? t.EnumerateArray().Select(x => x.GetString()).ToArray() : null,
                }
            });
            var payload = await verifyResp.Content.ReadAsStringAsync();
            if (!verifyResp.IsSuccessStatusCode)
            {
                Error = $"Registration failed: {payload}";
                return;
            }
            Ok = "Passkey registered — signing you in…";
            // Registration implies a fresh session for this admin.
            await Task.Delay(600);
            Nav.NavigateTo("/dashboard", forceLoad: true);
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }
}
