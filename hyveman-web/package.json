{
  "name": "hyveman-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Hyveman operations console — React + TypeScript + Vite frontend for the hyveman-api web API.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest",
    "test:run": "vitest run",
    "preview": "vite preview",
    "api:fetch": "node scripts/fetch-openapi.mjs",
    "api:generate": "orval",
    "api:check": "npm run api:generate > /dev/null && git diff --quiet -- src/api/generated || { echo 'ERROR: generated API client is stale — run npm run api:generate'; exit 1; }",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hookform/resolvers": "^5.0.1",
    "@mui/icons-material": "^7.3.0",
    "@mui/material": "^7.3.0",
    "@simplewebauthn/browser": "^12.0.0",
    "@simplewebauthn/types": "^12.0.0",
    "@tanstack/react-query": "^5.80.0",
    "@tanstack/react-virtual": "^3.13.0",
    "echarts": "^5.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.57.0",
    "react-router-dom": "^7.6.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "orval": "^7.9.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
