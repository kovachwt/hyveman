<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Hyveman.Api</RootNamespace>
    <AssemblyName>hyveman-api</AssemblyName>
    <Version>0.1.0</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
    <UserSecretsId>hyveman-api</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Hyveman.Application\Hyveman.Application.csproj" />
    <ProjectReference Include="..\Hyveman.Infrastructure.Sqlite\Hyveman.Infrastructure.Sqlite.csproj" />
    <ProjectReference Include="..\Hyveman.Infrastructure.Security\Hyveman.Infrastructure.Security.csproj" />
    <ProjectReference Include="..\Hyveman.Infrastructure.Redfish\Hyveman.Infrastructure.Redfish.csproj" />
    <ProjectReference Include="..\Hyveman.Infrastructure.Notify\Hyveman.Infrastructure.Notify.csproj" />
  </ItemGroup>
</Project>
